    \node [root] (twelve) at (-1.5, 12) {12};
    \node [leaf] (e)      at (-3, 9) {e:5};

    \node [root] (seven) at (0, 9) {7};
    \node [leaf] (d)      at (-1.5, 6) {d:3};

    \node [root] (four) at ( 1.5, 6) {4};
    \node [leaf] (c)    at (0, 3) {c:2};

    \node [root] (two) at (3, 3) {2};
    \node [leaf] (a)   at (1.5, 0) {a:1};
